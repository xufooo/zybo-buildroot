# Buildroot Defconfig — ZYBO Audio DSP (Buildroot 2026.02.3)
# Architecture: ARM Cortex-A9, Zynq-7000 XC7Z010
BR2_arm=y
BR2_cortex_a9=y
BR2_ARM_ENABLE_NEON=y
BR2_ARM_ENABLE_VFP=y
BR2_ARM_FPU_VFPV3D16=y

# Toolchain: Bootlin prebuilt external toolchain (avoids building gcc/glibc; the Bootlin stable toolchain bundled with Buildroot 2026.02.3)
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_ARMV7_EABIHF_GLIBC_STABLE=y

# System
BR2_TARGET_GENERIC_HOSTNAME="zybo-audio"
BR2_TARGET_GENERIC_ISSUE="ZYBO Audio DSP"
BR2_INIT_BUSYBOX=y
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_DEVTMPFS=y

# Kernel: linux-xlnx 6.6 LTS (tag-pinned, Vitis 2024.1 official line + upstream stable fixes)
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_CUSTOM_REPO_URL="https://github.com/Xilinx/linux-xlnx.git"
BR2_LINUX_KERNEL_CUSTOM_REPO_VERSION="xlnx_rebase_v6.6_LTS_2024.1_merge_6.6.80"
BR2_LINUX_KERNEL_DEFCONFIG="xilinx_zynq"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_ZYBO_AUDIO_PATH)/board/zybo-revb/linux.fragment"
BR2_LINUX_KERNEL_UIMAGE=y
BR2_LINUX_KERNEL_UIMAGE_LOADADDR="0x00008000"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
# ZYBO Rev B audio custom DTS (layered on the xlnx zynq-zybo tree, see external/overlays/zybo-audio.dts)
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_ZYBO_AUDIO_PATH)/overlays/zybo-audio.dts"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="zybo-audio"

# Boot: U-Boot 2024.01 (generic Zynq-7000 config xilinx_zynq_virt + DEVICE_TREE=zynq-zybo)
# BOOT.BIN = the SPL's spl/boot.bin (loaded directly by the BootROM, no FSBL/bootgen needed); the bitstream
# is loaded by U-Boot's uEnv.txt with `fpga loadb` (same approach as the official meta-xilinx zybo-zynq7)
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BUILD_SYSTEM_KCONFIG=y
BR2_TARGET_UBOOT_CUSTOM_GIT=y
BR2_TARGET_UBOOT_CUSTOM_REPO_URL="https://source.denx.de/u-boot/u-boot.git"
BR2_TARGET_UBOOT_CUSTOM_REPO_VERSION="v2024.01"
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="xilinx_zynq_virt"
BR2_TARGET_UBOOT_CUSTOM_MAKEOPTS="DEVICE_TREE=zynq-zybo"
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYTHON3=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="spl/boot.bin"
BR2_TARGET_UBOOT_FORMAT_IMG=y

# Root filesystem
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_ROOTFS_TAR=y

# SD card (v1: no sdcard.img -- BOOT.BIN needs the FPGA .xsa + bootgen, so CI only emits the image ingredients)
# Once the FPGA artifacts are ready, wire in genimage + BOOT.BIN to produce a flashable sdcard.img
# BR2_PACKAGE_HOST_GENIMAGE=y
# BR2_ROOTFS_POST_IMAGE_SCRIPT="$(BR2_EXTERNAL_ZYBO_AUDIO_PATH)/board/zybo-revb/post-image.sh"

# Rootfs overlay
# BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_ZYBO_AUDIO_PATH)/board/zybo-revb/rootfs_overlay"
# post-build: write /etc/asound.conf (44.1k -> 48k plug resampling)
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_ZYBO_AUDIO_PATH)/board/zybo-revb/post-build.sh"

# -- Packages: Phase 1 (get sound out first) -------------------------------
# ALSA tools (aplay / amixer / speaker-test)
BR2_PACKAGE_ALSA_LIB=y
BR2_PACKAGE_ALSA_UTILS=y
BR2_PACKAGE_ALSA_UTILS_APLAY=y
BR2_PACKAGE_ALSA_UTILS_AMIXER=y
BR2_PACKAGE_ALSA_UTILS_SPEAKER_TEST=y
# I2C tools (i2cdetect to verify codec 0x1A)
BR2_PACKAGE_I2C_TOOLS=y

# -- Phase 2/4 (not enabled yet): MPD / shairport-sync / dropbear etc., added after sound is verified --
